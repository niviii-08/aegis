# AEGIS Inference API Configuration

# API Settings
API_TITLE=AEGIS Inference API
API_VERSION=1.0.0
API_DESCRIPTION=Deepfake detection inference API for AEGIS

# Server Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
LOG_LEVEL=INFO

# File Upload Settings (in bytes)
MAX_FILE_SIZE=104857600  # 100MB
MAX_IMAGE_SIZE=10485760  # 10MB
MAX_VIDEO_SIZE=104857600  # 100MB
MAX_AUDIO_SIZE=52428800  # 50MB

# Temporary File Settings
TEMP_DIR=temp
TEMP_FILE_TTL=3600  # 1 hour in seconds

# Model Settings
PROJECT_ROOT=.
MODELS_DIR=models

# Logging
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# Inference Settings
DEVICE=auto  # auto, cpu, cuda
BATCH_SIZE=1
THRESHOLD=0.5
